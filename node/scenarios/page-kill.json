{
  "name": "page-kill",
  "what": "分頁匯出 × 排序器重啟（#41／#81）。兩個單獨都乾淨——`baseline` 加小預算乾淨、`hub-kill-takeover` 不分頁也乾淨——只有**合起來**會抓到「凍結的快照其實沒凍結」：`buildExport()` 是淺拷貝，`checkpoints` 與每條 `chains` 都是 Hub 那個陣列本身，於是分頁跨來回時第 1 頁與第 3 頁來自不同時刻，收方重算的 head root 對不上任何 checkpoint。`HUB_EXPORT_PAGE_BYTES=20000` 讓每一次取帳都必須分頁。",
  "portOffset": 1980,
  "seed": 31,
  "agents": 3,
  "verifiers": 3,
  "durationS": 200,
  "sampleS": 10,
  "maxOpenS": 150,
  "profile": {
    "mode": "latency",
    "latencyMs": 80,
    "jitterMs": 40
  },
  "timeline": [
    {
      "atS": 50,
      "action": "killHub"
    },
    {
      "atS": 80,
      "action": "startHub",
      "import": true
    }
  ],
  "expect": [
    {
      "kind": "invariantsHold"
    },
    {
      "kind": "settlesBefore",
      "atS": 50
    },
    {
      "kind": "noSettlementDuring",
      "fromS": 55,
      "toS": 78
    },
    {
      "kind": "settlementResumesWithin",
      "afterS": 80,
      "withinS": 70
    },
    {
      "kind": "marketMetrics",
      "minFillRate": 0.5,
      "minDepth": 1.0
    }
  ],
  "hubEnv": {
    "HUB_EXPORT_PAGE_BYTES": "20000"
  }
}
